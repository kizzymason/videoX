# 复制为 .env 后填写。生产 compose 不会回落到 .env.example 的 dev_* 密钥。
#   cp .env.production.example .env
#   openssl rand -hex 32   # 每个密钥跑一次

NODE_ENV=production
HTTP_PORT=80

POSTGRES_USER=videox
POSTGRES_PASSWORD=
POSTGRES_DB=videox

# 浏览器看到的公网地址（cloudflared / 反代的 https）。同一域名即可。
API_PUBLIC_URL=https://example.com
SITE_PUBLIC_URL=https://example.com
MOBILE_PUBLIC_URL=https://example.com/m
ADMIN_PUBLIC_URL=https://example.com/admin

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PLAY_TOKEN_SECRET=
HLS_KEY_SECRET=
COOKIE_SECRET=

STORAGE_DRIVER=local
TRANSCODE_CONCURRENCY=2
TRANSCODE_PRESET=veryfast
TRANSCODE_HWACCEL=none
