# 复制为 .env 后填写。生产 compose 不会回落到 .env.example 的 dev_* 密钥。
#   cp .env.production.example .env
#   openssl rand -hex 32   # 每个密钥跑一次

NODE_ENV=production
HTTP_PORT=80
HTTPS_PORT=443
# 宿主机证书目录，内含 domain.cert.pem（完整链）与 private.key.pem。
SSL_CERTS_DIR=./certs

POSTGRES_USER=videox
POSTGRES_PASSWORD=
POSTGRES_DB=videox

# 浏览器看到的公网地址。必须是 https:// 正式域名，cookie 才会带 Secure。
API_PUBLIC_URL=https://pandagv.com
SITE_PUBLIC_URL=https://pandagv.com
MOBILE_PUBLIC_URL=https://pandagv.com/m
ADMIN_PUBLIC_URL=https://pandagv.com/admin
# www 会 301 到 apex；仍放行以免跳转前的跨域请求被拒。
EXTRA_CORS_ORIGINS=https://www.pandagv.com

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PLAY_TOKEN_SECRET=
HLS_KEY_SECRET=
COOKIE_SECRET=

STORAGE_DRIVER=local
TRANSCODE_CONCURRENCY=1
TRANSCODE_PRESET=veryfast
TRANSCODE_HWACCEL=none

# --- 性能与并发（默认值按 4 核 / 8G 机器给，改机型时一起调）-------------------
# API 进程数。留一个核给 nginx 与 worker，通常取 核数 - 2。
API_CLUSTER_WORKERS=2
# 每个 API 进程的 PG 连接上限。API 进程数 × 该值 + worker 池 要小于 PG_MAX_CONNECTIONS。
DB_POOL_MAX=20
WORKER_DB_POOL_MAX=10
# argon2 密码校验跑在 libuv 线程池上，默认 4 会让并发登录排队。
UV_THREADPOOL_SIZE=8
API_NODE_OPTIONS=--max-old-space-size=768
WORKER_NODE_OPTIONS=--max-old-space-size=1024

# ffmpeg 不限流会把核吃光导致接口超时。
WORKER_CPU_LIMIT=2.5
WORKER_MEM_LIMIT=3g

# 本地盘的 HLS 分片改由 nginx sendfile 发送，Node 只做鉴权。置空则回到 Node 转发。
MEDIA_ACCEL_PREFIX=/__accel

PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=1536MB
PG_EFFECTIVE_CACHE_SIZE=4GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=256MB

# 采集系统：号池/调度/热链策略在管理后台配置（collection_configs 表）。
# API 进程跑定时调度，现有 worker 进程消费 collection 队列，无需单独环境变量。
