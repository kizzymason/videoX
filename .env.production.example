# 复制为 .env 后填写。生产 compose 不会回落到 .env.example 的 dev_* 密钥。
#   cp .env.production.example .env
#   openssl rand -hex 32   # 每个密钥跑一次

NODE_ENV=production
HTTP_PORT=80
HTTP_ALT_PORT=8080

POSTGRES_USER=videox
POSTGRES_PASSWORD=
POSTGRES_DB=videox

# 浏览器看到的公网地址。先用 IP 时写 http://x.x.x.x ；上证书后改成 https://域名。
API_PUBLIC_URL=http://example.com
SITE_PUBLIC_URL=http://example.com
MOBILE_PUBLIC_URL=http://example.com/m
ADMIN_PUBLIC_URL=http://example.com/admin

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PLAY_TOKEN_SECRET=
HLS_KEY_SECRET=
COOKIE_SECRET=

STORAGE_DRIVER=local
TRANSCODE_CONCURRENCY=1
TRANSCODE_PRESET=veryfast
TRANSCODE_HWACCEL=none

# 采集系统：号池/调度/热链策略在管理后台配置（collection_configs 表）。
# API 进程跑定时调度，现有 worker 进程消费 collection 队列，无需单独环境变量。
