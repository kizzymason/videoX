# ---------------------------------------------------------------------------
# videoX 环境变量。复制为 .env 后按需修改。
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- 数据库 / 队列 (与 docker-compose.yml 对应) ---------------------------
# 端口刻意避开 5432/6379，防止与本机已安装的 PostgreSQL / 其它项目的 Redis 抢占。
DATABASE_URL=postgresql://videox:videox_dev_password@localhost:15433/videox
REDIS_URL=redis://localhost:6380

# --- 服务端口 --------------------------------------------------------------
API_PORT=4000
WEB_PC_PORT=5173
WEB_MOBILE_PORT=5174
ADMIN_PORT=5175

# --- 对外可访问的地址（生成绝对链接 / sitemap / CORS 白名单） -------------
API_PUBLIC_URL=http://localhost:4000
SITE_PUBLIC_URL=http://localhost:5173
MOBILE_PUBLIC_URL=http://localhost:5174
ADMIN_PUBLIC_URL=http://localhost:5175

# --- 密钥（生产环境务必替换成 64 位随机串: openssl rand -hex 32） ----------
JWT_ACCESS_SECRET=dev_access_secret_change_me_0123456789abcdef
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_0123456789abcdef
PLAY_TOKEN_SECRET=dev_play_token_secret_change_me_0123456789abcd
HLS_KEY_SECRET=dev_hls_key_secret_change_me_0123456789abcdef
COOKIE_SECRET=dev_cookie_secret_change_me_0123456789abcdef
ACCOUNT_CREDENTIALS_KEY=dev_account_credentials_change_me_0123456789abcdef

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PLAY_TOKEN_TTL_SECONDS=7200

# --- 存储 ------------------------------------------------------------------
# 默认本地磁盘；S3 兼容配置可在管理后台「存储配置」里动态切换并持久化到数据库。
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage

# 可选：作为初始化 S3 配置的种子（后台保存后以数据库为准）
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# --- 转码 ------------------------------------------------------------------
TRANSCODE_CONCURRENCY=2
TRANSCODE_PRESET=veryfast
# 硬件编码：none | nvenc | qsv
TRANSCODE_HWACCEL=none
UPLOAD_TMP_DIR=./storage/tmp

# --- 播放安全 --------------------------------------------------------------
# 单账号同时在线播放数上限
MAX_CONCURRENT_STREAMS=3
# playToken 绑定 IP 的前缀位数（IPv4 取前 N 段），0 表示不绑定 IP
PLAY_TOKEN_IP_PREFIX_PARTS=3

# --- 统计 ------------------------------------------------------------------
# 可选：MaxMind GeoLite2-City.mmdb 路径，留空则不解析地域
GEOIP_MMDB_PATH=

# --- 采集系统 --------------------------------------------------------------
# 号池、调度、热链/R2 策略在管理后台「采集系统」里配置，写入 collection_configs。
# 不需要额外环境变量。部署后请执行 db:migrate（含 0003 采集表）。
# 源站账号 Token 只放后台号池，不要写进本文件。

# --- 管理员种子账号 --------------------------------------------------------
SEED_ADMIN_EMAIL=admin@videox.local
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_USERNAME=admin
