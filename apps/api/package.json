{
  "name": "@videox/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/app.ts",
  "types": "./src/app.ts",
  "exports": {
    ".": "./src/app.ts",
    "./config/env": "./src/config/env.ts",
    "./core/db": "./src/core/db.ts",
    "./core/errors": "./src/core/errors.ts",
    "./core/logger": "./src/core/logger.ts",
    "./core/queue": "./src/core/queue.ts",
    "./core/redis": "./src/core/redis.ts",
    "./collection": "./src/modules/collection/index.ts",
    "./storage": "./src/modules/storage/index.ts",
    "./maintenance": "./src/modules/maintenance/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "tsx src/server.ts",
    "build": "echo \"api runs from TypeScript source via tsx\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@aws-sdk/s3-request-presigner": "^3.1112.0",
    "@node-rs/argon2": "^2.1.0",
    "@videox/db": "*",
    "@videox/shared": "*",
    "bullmq": "^6.1.2",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^6.0.1",
    "node-cron": "^3.0.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.13.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "5.9.3"
  }
}
