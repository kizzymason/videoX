# 生产静态：PC / 移动 / 后台打进同一份 nginx，同源反代 /api /media /static。
FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
RUN npm ci && npm rebuild lightningcss --foreground-scripts

ENV VITE_API_BASE_URL=/api
RUN npm run build -w @videox/web-pc \
  && npm run build -w @videox/web-mobile -- --base /m/ \
  && npm run build -w @videox/admin -- --base /_ap/ \
  && npm run build -w @videox/partner -- --base /admins/

FROM nginx:1.27-alpine
COPY deploy/nginx-main.conf /etc/nginx/nginx.conf
COPY deploy/proxy-headers.conf /etc/nginx/proxy-headers.conf
COPY deploy/ssl-params.conf /etc/nginx/ssl-params.conf
COPY deploy/hsts.conf /etc/nginx/hsts.conf
COPY deploy/videox-locations.conf /etc/nginx/videox-locations.conf
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
RUN mkdir -p /var/cache/nginx/videox /data/storage /etc/nginx/certs
COPY --from=build /app/apps/web-pc/dist /usr/share/nginx/html
COPY --from=build /app/apps/web-mobile/dist /usr/share/nginx/html/m
# 后台入口路径由站点设置决定，nginx 从这里取入口 HTML；目录名不带 admin 字样。
COPY --from=build /app/apps/admin/dist /usr/share/nginx/html/_ap
COPY --from=build /app/apps/partner/dist /usr/share/nginx/html/admins
EXPOSE 80 443
